{
  "info": {
    "name": "FoC User Service",
    "description": "Every route of the User Service, ordered so the whole collection runs top to bottom in the Collection Runner with no manual step: the OTPs are read out of Mailpit's HTTP API by a pre-request script.\n\nNeeds the compose stack up (`docker compose up`) - the service on baseUrl and Mailpit on mailpitUrl.\n\nEach address gets three OTP requests per ten minutes, shared across register, resend and forgot - so every folder here owns its own address and spends that budget deliberately. Every address is generated fresh per run, so the runner is safe to press repeatedly.\n\nAI Assistance Disclosure: Tool: Claude Code (model: Claude Opus 5), date: 2026-09-28. Scope: generated the requests, the assertions and the Mailpit OTP lookup. Author review: the full collection run green against the compose stack.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "mailpitUrl",
      "value": "http://localhost:8025"
    },
    {
      "key": "password",
      "value": "Passw0rdSafe"
    },
    {
      "key": "newPassword",
      "value": "Newpassw0rd"
    },
    {
      "key": "signupEmail",
      "value": ""
    },
    {
      "key": "resetEmail",
      "value": ""
    },
    {
      "key": "otp",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Unauthenticated on purpose: compose and the gateway need it before anyone has a token. 503 if the database is unreachable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "JWKS",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/.well-known/jwks.json",
            "description": "The public half of the signing key, derived from USER_JWT_PRIVATE_KEY. Other services verify access tokens against this, so only this service ever holds the private key - which is why tokens are RS256 and not HS256."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('publishes at least one RSA key', () => {",
                  "  const keys = pm.response.json().keys;",
                  "  pm.expect(keys).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(keys[0]).to.include.keys('kid', 'kty', 'n', 'e');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sign-up",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Alex Tan\",\n  \"email\": \"{{signupEmail}}\",\n  \"countryCode\": \"+65\",\n  \"mobileNumber\": \"91234567\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "201. No `users` row exists yet - the sign-up is only a Redis key holding the address and mobile encrypted and the password already hashed. This spends the first of this address's three OTP requests."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A throwaway address, fresh every run, so this never collides with another folder's",
                  "// account or eats into anyone's rate limit.",
                  "pm.collectionVariables.set(",
                  "  'signupEmail',",
                  "  `alex.${Date.now().toString(36)}@u.nus.edu`,",
                  ");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('names the account and when the code expires', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.userId).to.be.a('string');",
                  "  pm.expect(Date.parse(body.otpExpiresAt)).to.be.greaterThan(Date.now());",
                  "  pm.collectionVariables.set('userId', body.userId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register/resend-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{signupEmail}}\"\n}"
            },
            "description": "202, not 200: the code has been handed to the mail server, not yet read by anyone. Replaces the code inside a sign-up that is still waiting, without extending its 15-minute window - so Verify below uses this newer code. Request two of three."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('gives the new code an expiry', () => {",
                  "  pm.expect(Date.parse(pm.response.json().otpExpiresAt)).to.be.greaterThan(Date.now());",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{signupEmail}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "description": "200 with the auth response. The account row and its first refresh token are written in one transaction, and the user lands logged in rather than at a login form. The code is single-use, so replaying it gives OTP_EXPIRED. Verifying submits a code rather than requesting one, so it costs nothing against the limit."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Mailpit is a real inbox with an HTTP API, so the runner reads its own code instead",
                  "// of you copying one out of the browser. The six digits are already in the search",
                  "// result's Snippet, so one call is enough.",
                  "//",
                  "// Filtering by subject keeps the sign-up code and the reset code apart when both are",
                  "// in the same inbox; sorting by Created takes the newest, which is what a resend",
                  "// leaves behind.",
                  "const subject = \"Verify your FoC account\";",
                  "const email = pm.collectionVariables.get('signupEmail');",
                  "const query = encodeURIComponent('to:' + email);",
                  "",
                  "pm.sendRequest(",
                  "  `${pm.collectionVariables.get('mailpitUrl')}/api/v1/search?query=${query}`,",
                  "  (err, res) => {",
                  "    if (err) { throw new Error('Mailpit is unreachable at mailpitUrl: ' + err); }",
                  "    const message = res.json().messages",
                  "      .filter((m) => m.Subject === subject)",
                  "      .sort((a, b) => b.Created.localeCompare(a.Created))[0];",
                  "    if (!message) { throw new Error(`No \"${subject}\" email for ${email}`); }",
                  "    pm.collectionVariables.set('otp', message.Snippet.match(/\\b(\\d{6})\\b/)[1]);",
                  "  },",
                  ");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns a session and a USER account', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a('string');",
                  "  pm.expect(body.refreshToken).to.be.a('string');",
                  "  pm.expect(body.expiresIn).to.eql(900);",
                  "  pm.expect(body.user.role).to.eql('USER');",
                  "  pm.expect(body.user.userId).to.eql(pm.collectionVariables.get('userId'));",
                  "});",
                  "pm.test('never echoes the email or mobile back', () => {",
                  "  pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('signupEmail'));",
                  "  pm.expect(pm.response.text()).to.not.include('91234567');",
                  "});",
                  "",
                  "// Kept in variables, never in the file: nothing here is committed.",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "409 the address is now taken",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Alex Tan\",\n  \"email\": \"{{signupEmail}}\",\n  \"countryCode\": \"+65\",\n  \"mobileNumber\": \"91234567\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "409 EMAIL_TAKEN. Told plainly rather than hidden, because a sign-up form has to be able to say the address is taken - which is an account-enumeration oracle by definition, and the reason the rate limit is counted *before* this check. This is request three of three, so a fourth OTP request for this address inside ten minutes would be 429 instead."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('the error code is EMAIL_TAKEN', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('EMAIL_TAKEN');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Session",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "200 rather than 201 - a session is not a resource you can address afterwards. Login is not rate-limited by the OTP counter; it has its own five-failure lockout."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns a fresh pair', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a('string');",
                  "  pm.expect(body.refreshToken).to.not.eql(pm.collectionVariables.get('refreshToken'));",
                  "});",
                  "",
                  "// Kept in variables, never in the file: nothing here is committed.",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "200 with a new pair. Refreshing reloads the user from the database, so a role change or a deactivation takes effect within 15 minutes without any shared session store."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('rotates the refresh token', () => {",
                  "  pm.expect(pm.response.json().refreshToken).to.not.eql(",
                  "    pm.collectionVariables.get('refreshToken'),",
                  "  );",
                  "});",
                  "",
                  "// Rotation kills the old token, so the stored pair MUST be replaced - otherwise the",
                  "// next refresh looks like reuse and revokes every session this user has.",
                  "// Kept in variables, never in the file: nothing here is committed.",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "204, always - an unknown or already-revoked token still means you are logged out. The caller's id comes from the access token and never from the body, so you can only ever end your own session. Ends this session only; other devices keep theirs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh after logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "401. The logout above revoked this token. An unknown, an expired and a revoked token all answer identically, so nothing can be learned from which one you hold."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('the error code is TOKEN_INVALID', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('TOKEN_INVALID');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Password reset",
      "item": [
        {
          "name": "Register a second account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Alex Tan\",\n  \"email\": \"{{resetEmail}}\",\n  \"countryCode\": \"+65\",\n  \"mobileNumber\": \"91234567\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Its own address, because the sign-up one has already spent its three OTP requests and forgot-password would answer 429. Request one of three."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A throwaway address, fresh every run, so this never collides with another folder's",
                  "// account or eats into anyone's rate limit.",
                  "pm.collectionVariables.set(",
                  "  'resetEmail',",
                  "  `reset.${Date.now().toString(36)}@u.nus.edu`,",
                  ");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify it",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{resetEmail}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "description": "200. Now there is an ACTIVE account to reset the password of."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Mailpit is a real inbox with an HTTP API, so the runner reads its own code instead",
                  "// of you copying one out of the browser. The six digits are already in the search",
                  "// result's Snippet, so one call is enough.",
                  "//",
                  "// Filtering by subject keeps the sign-up code and the reset code apart when both are",
                  "// in the same inbox; sorting by Created takes the newest, which is what a resend",
                  "// leaves behind.",
                  "const subject = \"Verify your FoC account\";",
                  "const email = pm.collectionVariables.get('resetEmail');",
                  "const query = encodeURIComponent('to:' + email);",
                  "",
                  "pm.sendRequest(",
                  "  `${pm.collectionVariables.get('mailpitUrl')}/api/v1/search?query=${query}`,",
                  "  (err, res) => {",
                  "    if (err) { throw new Error('Mailpit is unreachable at mailpitUrl: ' + err); }",
                  "    const message = res.json().messages",
                  "      .filter((m) => m.Subject === subject)",
                  "      .sort((a, b) => b.Created.localeCompare(a.Created))[0];",
                  "    if (!message) { throw new Error(`No \"${subject}\" email for ${email}`); }",
                  "    pm.collectionVariables.set('otp', message.Snippet.match(/\\b(\\d{6})\\b/)[1]);",
                  "  },",
                  ");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/password/forgot",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{resetEmail}}\"\n}"
            },
            "description": "202 with a fixed message for any NUS address, whether or not it has an account - so there is nothing to read into the answer either way. No otpExpiresAt here, unlike resend-otp: that field would be a straight answer to \"does this address have an account\". This is also how the bootstrap admin claims its passwordless account. Request two of three."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('says the same thing it would for an unknown address', () => {",
                  "  pm.expect(pm.response.json().message).to.include('If an account exists');",
                  "});",
                  "pm.test('does not hint at an expiry', () => {",
                  "  pm.expect(pm.response.json()).to.not.have.property('otpExpiresAt');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/password/reset",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{resetEmail}}\",\n  \"otp\": \"{{otp}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}"
            },
            "description": "204, and deliberately no tokens: every refresh token is revoked, so every device logs in again - which is the point, since a reset is what you do when someone else may have had your password. It also lifts any login lockout, because forgetting your password is the usual way to get locked out."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Mailpit is a real inbox with an HTTP API, so the runner reads its own code instead",
                  "// of you copying one out of the browser. The six digits are already in the search",
                  "// result's Snippet, so one call is enough.",
                  "//",
                  "// Filtering by subject keeps the sign-up code and the reset code apart when both are",
                  "// in the same inbox; sorting by Created takes the newest, which is what a resend",
                  "// leaves behind.",
                  "const subject = \"Reset your FoC password\";",
                  "const email = pm.collectionVariables.get('resetEmail');",
                  "const query = encodeURIComponent('to:' + email);",
                  "",
                  "pm.sendRequest(",
                  "  `${pm.collectionVariables.get('mailpitUrl')}/api/v1/search?query=${query}`,",
                  "  (err, res) => {",
                  "    if (err) { throw new Error('Mailpit is unreachable at mailpitUrl: ' + err); }",
                  "    const message = res.json().messages",
                  "      .filter((m) => m.Subject === subject)",
                  "      .sort((a, b) => b.Created.localeCompare(a.Created))[0];",
                  "    if (!message) { throw new Error(`No \"${subject}\" email for ${email}`); }",
                  "    pm.collectionVariables.set('otp', message.Snippet.match(/\\b(\\d{6})\\b/)[1]);",
                  "  },",
                  ");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('hands back no session', () => pm.expect(pm.response.text()).to.be.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with the new password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{resetEmail}}\",\n  \"password\": \"{{newPassword}}\"\n}"
            },
            "description": "200. Proves the reset took, and that the account is usable immediately rather than sitting behind a lockout."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "// Kept in variables, never in the file: nothing here is committed.",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "401 the old password is dead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{resetEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "401. One failure out of the five that would lock the address - harmless on its own."
