          "name": "423 locked after five failures",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{lockEmail}}\",\n  \"password\": \"Wrongpassw0rd\"\n}"
            },
            "description": "Five wrong passwords in a row lock an address for 15 minutes. A locked address is refused before the database is touched and before bcrypt runs, which is most of the point of having a lockout. Anyone can lock anyone else out this way; that is the accepted trade-off."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The lockout counts failures per address whether or not an account exists, so a",
                  "// throwaway address locks exactly as a real one does and costs the run's own",
                  "// accounts nothing. Fresh each time, because a locked address stays locked for",
                  "// fifteen minutes.",
                  "const email = `locked.${Date.now().toString(36)}@u.nus.edu`;",
                  "pm.collectionVariables.set('lockEmail', email);",
                  "",
                  "// Four failures here; the request itself is the fifth, the one that locks.",
                  "const fail = (remaining, done) => {",
                  "  if (remaining === 0) { return done(); }",
                  "  pm.sendRequest({",
                  "    url: `${pm.collectionVariables.get('baseUrl')}/auth/login`,",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ email, password: 'Wrongpassw0rd' }) },",
                  "  }, () => fail(remaining - 1, done));",
                  "};",
                  "fail(4, () => {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('423 Locked', () => pm.response.to.have.status(423));",
                  "pm.test('the error code is ACCOUNT_LOCKED', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('ACCOUNT_LOCKED');",
                  "});",
                  "pm.test('says how long to wait', () => {",
                  "  pm.expect(pm.response.json().error.details.retryAfterSeconds).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
