# ---- Global -------------------------------------------------
LOG_LEVEL=
# Set production for deployed services; use development only in local testing.
# Supplier refuses SUPPLIER_DEV_AUTH=true when this is production.
NODE_ENV=production

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ---- Supplier service ---------------------------------------
# PostgreSQL connection, e.g. postgres://<user>:<password>@localhost:5432/supplier
SUPPLIER_DATABASE_URL=
# Port the service listens on (default 3002)
SUPPLIER_PORT=
# Optional: path to the seed CSV (default data/csv/supplier-seed-data.csv)
SUPPLIER_SEED_CSV=
# Where the User Service publishes its public signing keys, e.g.
# http://localhost:3001/.well-known/jwks.json (http://user-service:3001/... in compose)
SUPPLIER_JWKS_URL=
# Optional: only checked when set, matching the gateway
SUPPLIER_JWT_ISSUER=
SUPPLIER_JWT_AUDIENCE=
# LOCAL TESTING ONLY. true accepts X-User-Id / X-User-Role headers when no bearer token is sent,
# so Supplier can be tested in Postman without the User Service. Leave empty everywhere else;
# startup refuses it when NODE_ENV=production.
SUPPLIER_DEV_AUTH=
# Optional: database for `npm run test:int` (its name must end in _test). Default:
# postgres://foc:<SUPPLIER_POSTGRES_PASSWORD>@localhost:5434/supplier_test
SUPPLIER_TEST_DATABASE_URL=

# ---- Local database containers (compose) --------------------
# Password for the user-db container and the URL compose builds from it.
# Any value; it never leaves your machine. Compose falls back to a placeholder.
POSTGRES_PASSWORD=
# The same for the supplier-db container. Use a different value from POSTGRES_PASSWORD.
SUPPLIER_POSTGRES_PASSWORD=

# ---- User service -------------------------------------------
# See user-service/AGENTS.md. Use a SEPARATE key for each purpose.
USER_PORT=
# PostgreSQL connection, e.g. postgres://<user>:<password>@localhost:5432/users
USER_DATABASE_URL=
# Redis connection, e.g. redis://localhost:6379
USER_REDIS_URL=
# RS256 signing key: a PKCS#8 PEM, base64-encoded onto ONE line (a raw PEM spans
# many lines, which .env and compose do not handle). Only the User Service holds it;
# everyone else verifies via GET /.well-known/jwks.json. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 | tr -d '\n'
USER_JWT_PRIVATE_KEY=
# Key id published in the JWKS and in each token's `kid` header, e.g. dev-2026-09
USER_JWT_KID=
# 32 bytes, base64 — AES-256-GCM for the stored email and mobile number
USER_AES_KEY=
# HMAC key for the email_hash lookup column
USER_EMAIL_HMAC_KEY=
# HMAC key for stored OTPs
USER_OTP_HMAC_KEY=
# SMTP. In development these point at the Mailpit container (inbox on :8025)
USER_SMTP_HOST=
USER_SMTP_PORT=
USER_SMTP_USER=
USER_SMTP_PASS=
USER_SMTP_FROM=
# Becomes the first ADMIN, but only while the users table is still empty.
# Set it before the first deploy; that account is claimed via forgot-password.
# Must be an @u.nus.edu or @nus.edu.sg address, or the service refuses to start --
# forgot-password would not accept any other domain, so the account could never be claimed.
USER_BOOTSTRAP_ADMIN_EMAIL=
# Shared secret for GET /internal/users/:userId (never routed via the gateway)
USER_INTERNAL_SERVICE_KEY=

# ---- Logging service (N2H, issue #52) -----------------------
# PostgreSQL connection, e.g. postgres://<user>:<password>@localhost:5436/logging
LOGGING_DATABASE_URL=
# Password for the logging-db container in logging-service/compose.yaml. Its own, separate from
# every other service's. If you set it after the container's volume was created, the stored
# password does not change: recreate the volume or change it with ALTER USER.
LOGGING_POSTGRES_PASSWORD=
# Port the service listens on (default 3005)
LOGGING_PORT=
# The User Service's public keys. Required: reading the log store is ADMIN only and there is no
# dev-header fallback here, so a real token is the only way in.
LOGGING_JWKS_URL=
# Optional; checked only when set, matching the gateway.
LOGGING_JWT_ISSUER=
LOGGING_JWT_AUDIENCE=
# Comma-separated brokers. Leave empty until the shared Kafka broker (#75) is merged: with no
# broker, ingest is off and the query API still runs.
LOGGING_KAFKA_BROKERS=
# Default logging.lines. Must also exist in infra/kafka/topics.txt (#75) -- services never
# create topics.
LOGGING_KAFKA_TOPIC=
LOGGING_KAFKA_GROUP_ID=
# How long a line is kept (default 30 days) and how often the purge runs (default 60 minutes).
LOGGING_RETENTION_DAYS=
LOGGING_PURGE_INTERVAL_MINUTES=
# Integration tests only. Its name must end in _test; the default is logging_test on port 5436.
LOGGING_TEST_DATABASE_URL=

# ... Add more variables as needed

# Gateway settings are in api-gateway/.env.example.

# ---- Frontend -----------------------------------------------
# Frontend settings are in frontend/.env.example.
