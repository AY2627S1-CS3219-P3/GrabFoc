# Copy values into the git-ignored root .env for Compose.
ORDER_DB_HOST=order-db
ORDER_DB_PORT=5432
ORDER_DB_NAME=orders
ORDER_DB_USER=foc
ORDER_DB_PASSWORD=change-me-in-dotenv
# HTTP port (default 3005) and the User Service JWKS used to verify bearer tokens.
ORDER_PORT=3005
ORDER_JWKS_URL=http://user-service:3001/.well-known/jwks.json
# Supplier (location lookups) and Credit (reservations). The key must equal Credit's CREDIT_SERVICE_KEY.
ORDER_SUPPLIER_URL=http://supplier-service:3002
ORDER_CREDIT_URL=http://credit-service:3004
ORDER_CREDIT_SERVICE_KEY=
# Used only by isolated integration tests; never point at application data.
ORDER_TEST_DATABASE_URL=postgresql://order_test:isolated-test-only@order-test-db:5432/order_test
