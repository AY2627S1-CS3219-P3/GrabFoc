{
  "name": "chat-service",
  "version": "0.1.0",
  "private": true,
  "description": "FoC Chat Service. AI Assistance Disclosure: Claude Code (Claude Opus 5.5), 2026-11-08; scaffold following notification-service/package.json, plus Socket.IO (the chat plan). Author review: Reviewed by Deanson, 2026-11-09.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "test": "jest",
    "test:int": "jest --config jest.int.config.js",
    "migrate": "node dist/db/migrate-cli.js",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "try-chat": "node scripts/try-chat.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "jose": "^5.10.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.1",
    "ts-jest": "^29.4.14",
    "typescript": "^5.6.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/env.setup.ts"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.int\\.spec\\.ts$"
    ]
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
