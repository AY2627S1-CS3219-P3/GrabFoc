# AI Assistance Disclosure:
# Tool: Codex (model: GPT-6), date: 2026-10-13
# Scope: Document gateway routes, addresses, and existing Envoy infrastructure settings.
# Author review: Jie Yang reviewed the earlier template; the new settings await his review.
# Tool: Claude Code (model: Claude Opus 5.5), date: 2026-10-22
# Scope: Documented CREDIT_SERVICE_URL and GATEWAY_CREDITS_PREFIX for the Credit routes (#61).
# Author review: pending — Jie Yang to record the review.
# Tool: Claude Code (model: Claude Opus 5.5), date: 2026-11-08
# Scope: Documented CHAT_SERVICE_URL for the chat socket route (the chat plan).
# Author review: Reviewed by Deanson, 2026-11-09.

GATEWAY_PORT=3003
# Existing Envoy settings; these values preserve current behavior.
GATEWAY_LB_POLICY=ROUND_ROBIN
GATEWAY_CONNECT_TIMEOUT=3s
GATEWAY_ROUTE_TIMEOUT=0s
GATEWAY_ROUTE_IDLE_TIMEOUT=10s
GATEWAY_JWKS_FETCH_TIMEOUT=3s
GATEWAY_JWKS_CACHE_DURATION=60s
GATEWAY_WORKERS=2
# Compose addresses. For a gateway running directly on your host, use localhost instead.
USER_SERVICE_URL=http://user-service:3001
SUPPLIER_SERVICE_URL=http://supplier-service:3002
CREDIT_SERVICE_URL=http://credit-service:3004
# The chat socket (50-chat.routes.json). Required: the gateway won't start without it.
CHAT_SERVICE_URL=http://chat-service:3007
# Empty derives /.well-known/jwks.json from USER_SERVICE_URL.
USER_SERVICE_JWKS_URL=
GATEWAY_AUTH_PREFIX=/auth
GATEWAY_LOCATIONS_PREFIX=/locations
GATEWAY_CREDITS_PREFIX=/credits
# Leave these empty until User Service includes issuer and audience in its tokens.
GATEWAY_JWT_ISSUER=
GATEWAY_JWT_AUDIENCE=

# AI Assistance Disclosure update:
