ORDER_SERVICE_URL=http://order-service:3005
GATEWAY_ORDERS_PREFIX=/orders

# AI Assistance Disclosure update:
# Tool: Claude Code (model: Claude Opus 5.5), date: 2026-11-06
# Scope: Documented the edge listener settings (#141, PR #156 review).
# Author review (Jian Bing, 2026-11-07): Looked through the code and think it's okay.
# AI-generated (Claude Code).
# Edge listener: CloudFront's origin on AWS, where Terraform sets all three. Empty GATEWAY_EDGE_PORT = off.
# Compose does not pass these, so it stays off locally. Turning it on needs all three, or startup fails.
GATEWAY_EDGE_PORT=
# The X-Origin-Key value CloudFront sends: at least 32 printable characters (openssl rand -hex 32).
GATEWAY_ORIGIN_KEY=
# Where the edge listener sends every path outside /gateway/*.
FRONTEND_URL=http://frontend:3000
