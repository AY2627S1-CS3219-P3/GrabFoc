{
  "name": "credit-service",
  "version": "0.1.0",
  "private": true,
  "description": "FoC Credit Service",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "test": "jest",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test:int": "jest --config jest.int.config.js"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "1.11.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.2.6",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.6.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/env.setup.ts"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.int\\.spec\\.ts$"
    ]
  },
  "allowScripts": {
    "@confluentinc/kafka-javascript@1.11.0": true
  }
}
