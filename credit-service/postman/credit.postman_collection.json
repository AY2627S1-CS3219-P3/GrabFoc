    {
      "name": "1. Completed order (reserve → transfer)",
      "item": [
        {
          "name": "New users with wallets (UserRegistered via Kafka UI)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('orderId', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('requesterId', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('courierId', pm.variables.replaceIn('{{$guid}}'));",
                  "// This request creates the requester's wallet; this sends the courier's.",
                  "const courierId = pm.collectionVariables.get('courierId');",
                  "pm.sendRequest({",
                  "  url: pm.variables.replaceIn('{{kafkaUiUrl}}/api/clusters/foc/topics/user.events/messages'),",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ partition: 0, key: courierId, value: JSON.stringify({ type: 'UserRegistered', userId: courierId }), keySerde: 'String', valueSerde: 'String' }) },",
                  "}, (err, res) => pm.test('courier UserRegistered published', () => pm.expect(err || res.code).to.eql(200)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partition\": 0,\n  \"key\": \"{{requesterId}}\",\n  \"value\": \"{\\\"type\\\": \\\"UserRegistered\\\", \\\"userId\\\": \\\"{{requesterId}}\\\"}\",\n  \"keySerde\": \"String\",\n  \"valueSerde\": \"String\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{kafkaUiUrl}}/api/clusters/foc/topics/user.events/messages",
              "host": [
                "{{kafkaUiUrl}}"
              ],
              "path": [
                "api",
                "clusters",
                "foc",
                "topics",
                "user.events",
                "messages"
              ]
            },
            "description": "Wallets come only from UserRegistered (#79). Kafka UI publishes it for us, as the User Service will on sign-up; Credit reads it a moment later, so the next request waits for the wallet."
          }
        },
        {
          "name": "Reserve 3 credits (new order)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Credit reads UserRegistered from Kafka a moment after it is published: wait for the wallet.",
                  "const waits = Number(pm.collectionVariables.get('walletWaits'));",
                  "const noWalletYet = pm.response.code === 409 && pm.response.json().code === 'WALLET_NOT_FOUND';",
                  "if (noWalletYet && waits < 20) {",
                  "  pm.collectionVariables.set('walletWaits', waits + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestId);",
                  "  setTimeout(() => {}, 250);",
                  "} else {",
                  "  pm.collectionVariables.set('walletWaits', 0);",
                  "  pm.test('status 201', () => pm.response.to.have.status(201));",
                  "  pm.test('state is RESERVED', () => pm.expect(pm.response.json().state).to.eql('RESERVED'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Service-Key",
                "value": "{{serviceKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"requesterId\": \"{{requesterId}}\",\n  \"amount\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
